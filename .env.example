# Postgres connection string for the app db
DATABASE_URL=
# Postgres connection string for the test db (tests and CI)
DATABASE_URL_TEST=
# Secret used by Better Auth to sign sessions
BETTER_AUTH_SECRET=
# Google OAuth client id for sign-in
GOOGLE_CLIENT_ID=
# Google OAuth client secret for sign-in
GOOGLE_CLIENT_SECRET=
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Set to false to turn logging off entirely
LOG_ENABLED=true
# Request id format: base36 (8 characters) or uuid
REQUEST_ID_FORMAT=base36
